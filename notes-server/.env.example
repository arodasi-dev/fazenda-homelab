# Copie para ".env" e troque pelo seu token (gere com: openssl rand -hex 24)
NOTES_TOKEN=troque-por-um-token-longo-e-secreto

# Deixe 0. Só use 1 se quiser reiniciar containers pelo app (veja o README).
ENABLE_RESTART=0

# Crédito da API da Anthropic (opcional). Precisa de conta de organização e de uma chave de administrador.
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...
# CREDIT_TOTAL_USD=50          # quanto você comprou
# CREDIT_SINCE=2026-10-01      # data da compra (AAAA-MM-DD)
